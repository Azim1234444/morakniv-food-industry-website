# ---------------------------------------------------------------------------
# Morakniv Food Industry Malaysia — environment template
#
# Copy to `.env.local` and fill in real values. `.env.local` is git-ignored;
# this file is committed and must never contain a real key or password.
# ---------------------------------------------------------------------------

# Public base URL, used for canonical links, Open Graph tags and sitemap.xml.
# Set this to the production domain before launch.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Enquiry email (Resend)
#
# All three are required before the contact form can deliver anything. With
# any of them missing the form reports a delivery failure to the visitor
# rather than silently discarding the enquiry.
# ---------------------------------------------------------------------------

# API key from https://resend.com/api-keys — starts with `re_`.
# Keep this in `.env.local` and in the host's encrypted environment settings.
RESEND_API_KEY=

# Destination inbox for enquiries submitted through /contact.
ENQUIRY_TO_EMAIL=sales@moraknivfoodindustry.my

# Sender address. The domain must be verified in Resend before delivery works.
# Accepts a friendly name: "Morakniv Food Industry <enquiries@example.com>"
ENQUIRY_FROM_EMAIL=

# Send the customer an automated acknowledgement of receipt.
# Set to exactly `true` to enable; anything else leaves it off.
ENQUIRY_AUTOREPLY=false
